# ─────────────────────────────────────────────────────────────────────────────
#  CodeSpace Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# ─── AI Provider Selection ────────────────────────────────────────────────────
# Options: anthropic | openai | gemini | ollama
ACTIVE_AI_PROVIDER=anthropic

# Anthropic (Claude) — Primary
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (optional, or used for embeddings fallback)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Google Gemini (optional)
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── RAG / Vector Store ───────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000

# ─── Database / Convex ───────────────────────────────────────────────────────
CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_URL=https://your-project.convex.cloud

# ─── Firebase (Admin SDK) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── GitHub Integration ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ─── Code Execution (Piston API) ─────────────────────────────────────────────
PISTON_API_URL=https://emkc.org/api/v2/piston

# ─── Inngest (Background Jobs) ────────────────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxx

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Sentry (Error Monitoring - Optional) ────────────────────────────────────
# SENTRY_DSN=https://xxxx@sentry.io/xxxxx
